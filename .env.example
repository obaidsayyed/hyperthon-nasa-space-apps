# Backend mode is deliberately disabled until the backend team implements docs/API-CONTRACT.md.
# Keep `mock` during frontend-only development; switch to `api` for backend integration testing.
VITE_BACKEND_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=20000

# Optional overrides. When API mode is enabled, defaults are /v1/auth/login and /v1/auth/logout.
VITE_AUTH_LOGIN_ENDPOINT=
VITE_AUTH_LOGOUT_ENDPOINT=
VITE_GEOCODING_ENDPOINT=

# ElevenLabs: use the bare agent ID or talk-to URL; the widget initializer extracts the agent_id.
VITE_ELEVENLABS_AGENT_ID=agent_5301m64nw8dnenjrtta28828fwz3

# Optional street basemap style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
